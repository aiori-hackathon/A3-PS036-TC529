# docker/Dockerfile.build — CLIMB toolchain build
#
# Multi-stage build: compiles OpenSSL ≥3.1.0, liboqs, and libMTL from pinned
# submodules. The default (builder) stage includes test binaries for smoke
# verification. The `final` stage copies only libraries and headers into a clean
# /out/ tree suitable for extraction.
#
# ── Pinned dependencies ──
# Base image:  debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
# apt packages: explicit versions resolved from that pinned image on 2026-11-08
# OpenSSL:     3.4.1, SHA-256 002a2d6b30b58bf4bea46c43bdd96365aaf8daa6c428782aa4feee06da197df3
# liboqs:      5a1a854  (liboqs 0.16.0; git submodule at third_party/liboqs)
# libMTL:      53ce25d (git submodule at third_party/MTL)
# ──────────────────────────

# ── Stage 1: full builder (default) ──────────────────────────────────────
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS builder

# Build dependencies — the minimum needed for autotools + CMake + OpenSSL.
# Every direct package is version-pinned to the candidate that the pinned base
# image resolved on 2026-11-08. Transitive dependencies still come from the
# live Debian repository; the reproducibility note lists that limitation.
RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf=2.71-3 \
    automake=1:1.16.5-1.3 \
    bc=1.07.1-3+b1 \
    build-essential=12.9 \
    ca-certificates=20250419~deb12u2 \
    cmake=3.25.1-1 \
    libtool=2.4.7-7~deb12u1 \
    ninja-build=1.11.1-2~deb12u1 \
    perl=5.36.0-7+deb12u4 \
    pkg-config=1.8.1-1 \
    wget=1.21.3-1+deb12u1 \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────────────────
# 1. OpenSSL ≥ 3.1.0  (Bookworm ships 3.0.x — not new enough for libMTL)
# ─────────────────────────────────────────────────────────────────────────
ARG OPENSSL_VERSION=3.4.1
ARG OPENSSL_SHA256=002a2d6b30b58bf4bea46c43bdd96365aaf8daa6c428782aa4feee06da197df3
RUN wget -q "https://www.openssl.org/source/openssl-${OPENSSL_VERSION}.tar.gz" \
    && echo "${OPENSSL_SHA256}  openssl-${OPENSSL_VERSION}.tar.gz" | sha256sum -c - \
    && tar xzf "openssl-${OPENSSL_VERSION}.tar.gz" \
    && cd "openssl-${OPENSSL_VERSION}" \
    && ./Configure --prefix=/usr/local --libdir=lib \
        enable-fips \
        -Wl,-rpath,/usr/local/lib \
    && make -j"$(nproc)" \
    && make install_sw \
    && cd .. && rm -rf "openssl-${OPENSSL_VERSION}" "openssl-${OPENSSL_VERSION}.tar.gz"

# ─────────────────────────────────────────────────────────────────────────
# 2. liboqs — pinned submodule, SLH-DSA only, shared lib
# ─────────────────────────────────────────────────────────────────────────
COPY third_party/liboqs /src/liboqs
WORKDIR /src/liboqs

RUN mkdir -p build && cd build \
    && cmake -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_SHARED_LIBS=ON \
        -DOQS_MINIMAL_BUILD="SIG_slh_dsa;SIG_ml_dsa" \
        -DOQS_BUILD_ONLY_LIB=ON \
        -DOQS_DIST_BUILD=ON \
        -DOQS_USE_OPENSSL=ON \
        -DOPENSSL_ROOT_DIR=/usr/local \
        .. \
    && ninja -j"$(nproc)" \
    && ninja install \
    && cd / && rm -rf /src/liboqs

# Register shared libs for the linker
RUN echo "/usr/local/lib" >> /etc/ld.so.conf.d/climb-local.conf && ldconfig

# ─────────────────────────────────────────────────────────────────────────
# 3. libMTL — pinned submodule, autotools, linked against our OpenSSL+liboqs
# ─────────────────────────────────────────────────────────────────────────
COPY third_party/MTL /src/MTL
WORKDIR /src/MTL

# NOTE: configure.ac clobbers CFLAGS on line 22-25 — do NOT pass CFLAGS at
# configure time.  CPPFLAGS / LDFLAGS are safe.  Leaving CFLAGS unset gives
# autoconf's default -g -O2 (adequate for build verification).
# FIX-2 (2026-09-26): patched test/mtltest_mtllib.c for liboqs 0.16.0 compat
# — OQS_SIG_*_length_public_key macros replaced with runtime OQS_SIG_new().
# test/ and examples/ now compile and pass against the pinned liboqs build.
RUN autoreconf --install \
    && CPPFLAGS="-I/usr/local/include" \
       LDFLAGS="-L/usr/local/lib -Wl,-rpath,/usr/local/lib" \
       ./configure --libdir=/usr/local/lib \
    && make -C src -j"$(nproc)" \
    && make -C src install \
    && make -C test -j"$(nproc)" \
    && make -C examples -j"$(nproc)" \
    && ldconfig

WORKDIR /

# ── Stage 2: clean artifact-only stage ──────────────────────────────────
# Extract with:  docker build --target final -t climb-libs . \
#                  && docker create --name climb-out climb-libs \
#                  && docker cp climb-out:/out . && docker rm climb-out
FROM scratch AS final
COPY --from=builder /usr/local/lib     /out/lib
COPY --from=builder /usr/local/include /out/include
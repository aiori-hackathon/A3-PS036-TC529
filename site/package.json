{
  "name": "climb-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config playwright.ui.config.ts",
    "lint": "eslint .",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fonts": "python3 scripts/build-fonts.py",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}

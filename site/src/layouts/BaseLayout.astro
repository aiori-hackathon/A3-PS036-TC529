---
import '../styles/global.css';
import '../styles/climb.css';
import Fact from '../components/Fact.astro';
import provenance from '../data/generated/provenance.json';
import { SCOPE_SENTENCE } from '../lib/limits';

interface Props {
  title: string;
  description: string;
  /** The home route adds the page-index rail; other routes keep the shell. */
  home?: boolean;
}

const { title, description, home = false } = Astro.props;
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og-image.png', site);

const repository = 'https://github.com/aiori-hackathon/A3-PS036-TC529';
const nav = [
  { label: 'Results', href: '#results' },
  { label: 'Capabilities', href: '#capabilities' },
  { label: 'Ladder', href: '#ladder' },
  { label: 'How it works', href: '#how' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'Transparency', href: '#transparency' },
  { label: 'Team', href: '#team' },
];

const keywords: { text: string; fact?: string }[] = [
  { text: 'post-quantum' },
  { text: 'SLH-DSA' },
  { text: 'Merkle Tree Ladder' },
  { text: 'DNSSEC' },
  { text: 'amortisation' },
  { text: 'condensed authentication path' },
  { text: 'wire bytes' },
  { text: '-byte UDP payload', fact: 'F-udp-payload' },
  { text: 'libMTL' },
  { text: 'liboqs' },
  { text: 'Criterion' },
  { text: 'reproducible' },
  { text: 'evidence classes' },
  { text: 'claims registry' },
  { text: 'NSD and Unbound' },
  { text: 'Rust' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#13161b" />
    <meta name="color-scheme" content="dark" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CLIMB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The CLIMB wordmark on the ink background." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#top">Skip to content</a>

    <div class="orbs" aria-hidden="true"><i></i><i></i><i></i></div>
    <svg
      width="0"
      height="0"
      style="position:absolute"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <filter
          id="lg"
          x="-0.05"
          y="-0.05"
          width="1.1"
          height="1.1"
          color-interpolation-filters="sRGB"
        >
          <feTurbulence
            type="fractalNoise"
            baseFrequency=".007 .011"
            numOctaves="2"
            seed="7"
            result="n"
          ></feTurbulence>
          <feGaussianBlur in="n" stdDeviation="2" result="nb"></feGaussianBlur>
          <feDisplacementMap
            in="SourceGraphic"
            in2="nb"
            scale="22"
            xChannelSelector="R"
            yChannelSelector="G"
          ></feDisplacementMap>
        </filter>
      </defs>
    </svg>
    <canvas id="fx" aria-hidden="true"></canvas>

    <header id="hd">
      <div class="w">
        <a class="brand logo" href="/#top" aria-label="CLIMB home"></a>
        <button id="mn" aria-expanded="false" aria-controls="nv">Menu</button>
        <nav id="nv" aria-label="Primary">
          {nav.map((item) => <a href={home ? item.href : `/${item.href}`}>{item.label}</a>)}
          <a class="btn" href={repository} rel="noopener">GitHub</a>
        </nav>
      </div><i id="pb" aria-hidden="true"></i>
    </header>

    {home ? (
      <aside id="sc" aria-label="Page index">
        <div id="rl"></div><i id="ix"></i><span id="pr">0&#37;</span>
      </aside>
    ) : null}

    <main id="top">
      <slot />
    </main>

    <footer id="ft">
      <div class="w">
        <div class="fh">
          <h2>Sign once. Prove many.</h2>
          <div class="gs">
            <span>Clone it, rebuild every number, check the claims yourself.</span>
            <div class="cmd">
              <code>git clone --recurse-submodules https://github.com/aiori-hackathon/A3-PS036-TC529 climb</code>
              <button
                type="button"
                data-c="git clone --recurse-submodules https://github.com/aiori-hackathon/A3-PS036-TC529 climb"
              >
                Copy
              </button>
            </div>
            <a class="btn p" href={repository} rel="noopener">Open the repository</a>
          </div>
        </div>
        <ul class="kw" aria-label="Project keywords">
          {keywords.map((word, index) => (
            <li class={index % 4 === 0 ? 'r' : index % 4 === 2 ? 'o' : undefined}>
              {word.fact === undefined ? (
                word.text
              ) : (
                <><Fact id={word.fact} bare />{word.text}</>
              )}
            </li>
          ))}
        </ul>
        <div class="fg">
          <div>
            <h3>CLIMB</h3>
            <p style="max-width:38ch">
              Cryptographic Ladder Impact Measurement Benchmark. A reproducible look at what
              Merkle Tree Ladder amortisation buys post-quantum DNSSEC.
            </p>
          </div>
          <div>
            <h3>Project</h3>
            <ul>
              <li><a href="/tui">Dashboard</a></li>
              <li><a href="/report">Report</a></li>
              <li><a href="/verify">Verify</a></li>
              <li><a href="/reproduce">Reproduce</a></li>
              <li><a href={repository} rel="noopener">GitHub repository</a></li>
              <li>
                <a href={`${repository}/blob/main/A3-PS036-TC529.pdf`} rel="noopener">
                  Presentation deck (PDF)
                </a>
              </li>
              <li>
                <a href="https://www.youtube.com/watch?v=gDHYamjWmtE" rel="noopener">
                  Introduction video
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3>Method</h3>
            <ul>
              <li>
                <a href={`${repository}/blob/main/docs/METHODOLOGY.md`} rel="noopener">
                  Research methodology
                </a>
              </li>
              <li>
                <a href={`${repository}/blob/main/docs/BASELINES.md`} rel="noopener">
                  Baselines A, B, C
                </a>
              </li>
              <li>
                <a href={`${repository}/blob/main/docs/ARCHITECTURE.md`} rel="noopener">
                  Documentation
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3>Event</h3>
            <ul>
              <li>
                <a href="https://portal.aiori.in/aiori-3/hackathon-guideline/" rel="noopener">
                  AIORI-3 guidelines
                </a>
              </li>
              <li>Track 2, Cyber Security</li>
              <li>PS-036 · A3-PS036-TC529</li>
            </ul>
          </div>
        </div>
        <p class="scope">{SCOPE_SENTENCE}</p>
        <div class="fb">
          <span>MIT licence. <Fact id="F-claims-count" bare /> verified.</span>
          <span>Artifact commit <code>{provenance.commit_short}</code>.</span>
          <span>Experimental research benchmark. No formal security guarantee is claimed.</span>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/climb-main.js';
      import '../scripts/climb-glass.js';
    </script>
  </body>
</html>

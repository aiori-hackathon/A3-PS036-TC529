---
/**
 * The dashboard window.
 *
 * One component serves both the `/tui` page and the window embedded on the
 * home route: a frame, the focusable grid the WebAssembly module draws into,
 * the keyboard hint, and — on the full page — the touch control row. The
 * module is a build artifact, so the window has four honest states: waiting
 * for the reader to reach it, loading, ready, and a readable fault that names
 * how to build or reload it.
 */
import { TOUCH_CONTROLS, TUI_KEY_HINTS } from '../lib/tui';

interface Props {
  /** `page` loads immediately; `home` waits until the window is reached. */
  mode?: 'page' | 'home';
  class?: string;
}

const { mode = 'page', class: className = '' } = Astro.props;
const full = mode === 'page';
---

<div
  class:list={['tui-window', className]}
  data-tui-window
  data-tui-mode={mode}
  role="group"
  aria-labelledby={`tui-title-${mode}`}
>
  <div class="tui-window__bar">
    <p class="tui-window__title" id={`tui-title-${mode}`}>
      <span class="tui-window__lamp" aria-hidden="true"></span>
      climb — recorded dashboard
    </p>
    <p class="tui-window__meta">
      <span>webassembly</span>
      <span aria-hidden="true">·</span>
      <span>no server</span>
    </p>
  </div>

  <div
    class="tui-window__stage"
    data-tui-stage
    data-tui-state={full ? 'loading' : 'paused'}
    aria-busy={full ? 'true' : 'false'}
  >
    <div class="tui-window__viewport">
      <div
        id="grid"
        class="tui-window__grid"
        data-tui-grid
        data-keys="focus"
        tabindex="0"
        role="application"
        aria-label="CLIMB dashboard. Activate this window, then use the dashboard keys."
        aria-describedby="tui-keys"
      >
      </div>
    </div>

    <div class="tui-window__overlay" data-tui-overlay>
      <p class="tui-window__boot" id="boot" data-tui-boot hidden={!full}>
        Loading the recorded run…
      </p>

      <div class="tui-window__paused" data-tui-paused hidden={full}>
        <p class="tui-window__paused-line">
          The recorded dashboard loads when you reach this window.
        </p>
        <button class="tui-window__action" type="button" data-tui-load>
          Load the window
        </button>
      </div>

      <div class="tui-window__fault" data-tui-fault hidden aria-live="polite">
        <p class="tui-window__fault-title" data-tui-fault-title></p>
        <p class="tui-window__fault-body" data-tui-fault-body></p>
        <code class="tui-window__fault-code" data-tui-fault-code hidden></code>
        <p class="tui-window__fault-links">
          <button class="tui-window__action" type="button" data-tui-retry hidden>
            Try again
          </button>
          <a class="tui-window__link" href={full ? '#run' : '/tui#run'} data-tui-run-link data-page-only>
            Run it locally
          </a>
        </p>
      </div>

      <noscript>
        <style>
          [data-tui-overlay] > :not(noscript) {
            display: none;
          }
        </style>
        <p class="tui-window__paused-line">
          This window needs JavaScript. The terminal dashboard runs without it: see “Run it locally”.
        </p>
      </noscript>
    </div>
  </div>

  <div class="tui-window__foot">
    <ul class="tui-window__hints" id="tui-keys" data-tui-hints>
      {
        TUI_KEY_HINTS.map((hint) => (
          <li>
            <kbd>{hint.keys}</kbd>
            <span>{hint.action}</span>
          </li>
        ))
      }
    </ul>
    {
      full ? (
        <p class="tui-window__note">Click the window, then use the keys.</p>
      ) : (
        <a class="tui-window__link" href="/tui">
          Open full screen
        </a>
      )
    }
  </div>

  {
    full && (
      <div class="tui-window__controls" data-tui-controls role="group" aria-label="Dashboard controls">
        {TOUCH_CONTROLS.map((control) => (
          <button
            class="tui-window__key"
            type="button"
            data-tui-key={control.key}
            data-tui-shift={control.shift ? 'true' : undefined}
            aria-label={control.label}
          >
            {control.hint}
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  import {
    TUI_MANIFEST_PATH,
    TOUCH_CONTROLS,
    keyEventInit,
    parseManifest,
  } from '../lib/tui';

  type StageState = 'paused' | 'loading' | 'ready' | 'unavailable' | 'failed';

  const READY_TIMEOUT = 20_000;

  function member<T extends Element>(stage: HTMLElement, selector: string): T | null {
    return stage.querySelector<T>(selector);
  }

  function setState(stage: HTMLElement, state: StageState): void {
    stage.dataset.tuiState = state;
    stage.setAttribute('aria-busy', state === 'loading' ? 'true' : 'false');
    const boot = member<HTMLElement>(stage, '[data-tui-boot]');
    const paused = member<HTMLElement>(stage, '[data-tui-paused]');
    const fault = member<HTMLElement>(stage, '[data-tui-fault]');
    if (boot !== null) boot.hidden = state !== 'loading';
    if (paused !== null) paused.hidden = state !== 'paused';
    if (fault !== null) fault.hidden = state !== 'unavailable' && state !== 'failed';
  }

  function showFault(
    stage: HTMLElement,
    state: 'unavailable' | 'failed',
    title: string,
    body: string,
    detail: string | null,
    retry: boolean,
  ): void {
    setState(stage, state);
    const heading = member<HTMLElement>(stage, '[data-tui-fault-title]');
    const paragraph = member<HTMLElement>(stage, '[data-tui-fault-body]');
    const code = member<HTMLElement>(stage, '[data-tui-fault-code]');
    const again = member<HTMLButtonElement>(stage, '[data-tui-retry]');
    if (heading !== null) heading.textContent = title;
    if (paragraph !== null) paragraph.textContent = body;
    if (code !== null) {
      code.textContent = detail ?? '';
      code.hidden = detail === null;
    }
    if (again !== null) again.hidden = !retry;
  }

  /**
   * Load the module for one window. The fetch is same-origin; a body that is
   * not a dashboard build is a stated fault, not a thrown page error.
   */
  async function boot(stage: HTMLElement): Promise<void> {
    setState(stage, 'loading');
    let timer = 0;
    try {
      const response = await fetch(TUI_MANIFEST_PATH, { cache: 'no-store' });
      if (!response.ok) {
        showFault(
          stage,
          'unavailable',
          'The dashboard module is not in this build',
          'The page was built without the WebAssembly window. Build it from the repository, then copy it in with the site integration.',
          'cd crates/climb-web && trunk build --release',
          false,
        );
        return;
      }
      const manifest = parseManifest(await response.json());
      if (manifest === null) {
        throw new Error(`${TUI_MANIFEST_PATH} is not a dashboard build`);
      }

      timer = window.setTimeout(() => {
        if (stage.dataset.tuiState === 'loading') {
          showFault(
            stage,
            'failed',
            'The dashboard did not finish loading',
            'The module started but no frame arrived. Try again, or open the terminal dashboard below.',
            null,
            true,
          );
        }
      }, READY_TIMEOUT);

      const module: { default: (input: { module_or_path: string }) => Promise<unknown> } =
        await import(/* @vite-ignore */ manifest.entry);
      await module.default({ module_or_path: manifest.wasm });
      window.clearTimeout(timer);
      setState(stage, 'ready');
      stage.dispatchEvent(new CustomEvent('climb-tui-ready', { bubbles: true }));
    } catch (error) {
      window.clearTimeout(timer);
      const message = error instanceof Error ? error.message : String(error);
      showFault(
        stage,
        'failed',
        'The dashboard did not start',
        'The module is published beside this page but could not run. The console names the cause.',
        message,
        true,
      );
    }
  }

  /** Bind the touch row: one synthetic key per button, the dashboard's own. */
  function bindControls(windowElement: HTMLElement): void {
    const grid = member<HTMLElement>(windowElement, '[data-tui-grid]');
    if (grid === null) return;
    for (const button of windowElement.querySelectorAll<HTMLButtonElement>('[data-tui-key]')) {
      button.addEventListener('click', () => {
        const shift = button.dataset.tuiShift === 'true';
        const control = TOUCH_CONTROLS.find(
          (candidate) => candidate.key === button.dataset.tuiKey && candidate.shift === shift,
        );
        if (control === undefined) return;
        grid.dispatchEvent(new KeyboardEvent('keydown', keyEventInit(control)));
      });
    }
  }

  /** Run `callback` once the page has finished its own first paint. */
  function onIdle(callback: () => void): void {
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(callback, { timeout: 2_500 });
    } else {
      window.setTimeout(callback, 800);
    }
  }

  const saveData =
    (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  for (const frame of document.querySelectorAll<HTMLElement>('[data-tui-window]')) {
    const stage = member<HTMLElement>(frame, '[data-tui-stage]');
    if (stage === null) continue;
    bindControls(frame);
    const retry = member<HTMLButtonElement>(stage, '[data-tui-retry]');
    retry?.addEventListener('click', () => {
      void boot(stage);
    });
    const load = member<HTMLButtonElement>(stage, '[data-tui-load]');
    load?.addEventListener('click', () => {
      void boot(stage);
    });

    if (frame.dataset.tuiMode === 'page') {
      onIdle(() => {
        void boot(stage);
      });
      continue;
    }

    // The home window is an invitation, not an ambush: it never downloads the
    // module while the reader is still in the hero, and a data-saving reader
    // gets the button instead.
    if (saveData || window.matchMedia('(prefers-reduced-data: reduce)').matches) {
      continue;
    }
    onIdle(() => {
      const observer = new IntersectionObserver(
        (entries) => {
          if (window.scrollY === 0) return;
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          void boot(stage);
        },
        { rootMargin: '240px 0px' },
      );
      observer.observe(frame);
    });
  }
</script>

<style is:global>
  /*
   * The frame is a raised panel, not a glass card: flat surfaces, one boundary
   * token, and the same ink the terminal paints so a resize never flashes.
   */
  .tui-window {
    margin: 0;
    border: 1px solid var(--color-boundary);
    border-radius: var(--radius-panel);
    background-color: var(--color-raised);
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 35%);
    overflow: hidden;
  }

  .tui-window__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    border-bottom: 1px solid var(--color-rule);
    background-color: var(--color-surface);
    padding: 0.75rem 1rem;
  }

  .tui-window__title,
  .tui-window__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.25rem;
  }

  .tui-window__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-paper);
  }

  .tui-window__lamp {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background-color: var(--color-teal);
  }

  .tui-window__meta {
    display: flex;
    gap: 0.5rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .tui-window__stage {
    position: relative;
    background-color: var(--color-ink);
  }

  .tui-window__viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  /*
   * The dashboard is designed for a terminal of eighty columns; the window
   * keeps that floor and scrolls sideways below it rather than drawing the
   * terminal's own "too small" screen.
   */
  .tui-window__grid {
    width: max(100%, 48rem);
    height: clamp(30rem, 56vh, 38rem);
    outline: none;
    touch-action: pan-x pan-y;
  }

  .tui-window__grid canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tui-window__grid:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: -3px;
  }

  .tui-window__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background-color: var(--color-ink);
    text-align: center;
  }

  .tui-window__overlay > [hidden],
  .tui-window__fault-code[hidden],
  .tui-window__fault [hidden] {
    display: none !important;
  }

  [data-tui-state='ready'] .tui-window__overlay {
    display: none;
  }

  .tui-window__boot,
  .tui-window__paused-line,
  .tui-window__fault-title,
  .tui-window__fault-body {
    margin: 0;
    max-width: 32rem;
  }

  .tui-window__boot,
  .tui-window__paused-line {
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .tui-window__boot::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    border-radius: 999px;
    background-color: var(--color-orange);
    animation: tui-pulse 1.2s ease-in-out infinite;
  }

  .tui-window__paused,
  .tui-window__fault {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }

  .tui-window__fault-title {
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.2;
  }

  .tui-window__fault-body {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .tui-window__fault-code {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-control);
    background-color: var(--color-surface);
    padding: 0.5rem 0.75rem;
    color: var(--color-measured);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: pre;
  }

  .tui-window__fault-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 0;
  }

  .tui-window__action {
    border: 1px solid var(--color-boundary);
    border-radius: var(--radius-control);
    background-color: transparent;
    color: var(--color-text);
    padding: 0.5rem 0.9rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .tui-window__action:hover {
    border-color: var(--color-teal);
    color: var(--color-teal);
  }

  .tui-window__link {
    color: var(--color-orange);
    font-size: var(--text-sm);
    text-underline-offset: 2px;
  }

  .tui-window__link:hover {
    color: var(--color-paper);
  }

  .tui-window__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    border-top: 1px solid var(--color-rule);
    background-color: var(--color-surface);
    padding: 0.625rem 1rem;
  }

  .tui-window__hints {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0.3rem 0.75rem;
    list-style: none;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background-color: var(--color-raised);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .tui-window__hints li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .tui-window__hints kbd {
    border: 1px solid var(--color-rule);
    border-radius: 0.25rem;
    padding: 0 0.3rem;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .tui-window__note {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .tui-window__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-top: 1px solid var(--color-rule);
    padding: 0.75rem 1rem;
  }

  .tui-window__key {
    flex: 1 1 auto;
    min-width: 4.5rem;
    border: 1px solid var(--color-boundary);
    border-radius: var(--radius-control);
    background-color: var(--color-raised);
    color: var(--color-text);
    padding: 0.625rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .tui-window__key:hover {
    border-color: var(--color-teal);
    color: var(--color-teal);
  }

  .tui-window__overlay noscript p {
    margin: 0;
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  @keyframes tui-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tui-window__boot::before {
      animation: none;
      opacity: 1;
    }
  }
</style>

---
/**
 * A block that fades up once when it enters the viewport.
 *
 * The server renders the content in its final state, so a reader without
 * JavaScript, or with reduced motion, never sees a gap where the copy should
 * be. The client script opts the block into its hidden starting state only
 * when motion is allowed.
 */
interface Props {
  as?: 'div' | 'section' | 'article' | 'li';
  class?: string;
}

const { as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag class:list={['reveal', className]} data-reveal data-reveal-state="server">
  <slot />
</Tag>

<style>
  .reveal[data-reveal-state='pending'] {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    will-change: opacity, transform;
  }

  .reveal[data-reveal-state='shown'] {
    opacity: 1;
    transform: none;
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .reveal[data-reveal-state='pending'] {
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }
</style>

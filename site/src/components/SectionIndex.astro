---
interface Props {
  index: string;
  label?: string;
  class?: string;
}

const { index, label, class: className = '' } = Astro.props;
---

<p class:list={['section-index', className]}>
  <span class="section-index__mark" aria-hidden="true">
    /
  </span>
  <span class="section-index__number">{index}</span>
  {label !== undefined ? <span class="section-index__label">{label}</span> : null}
</p>

<style>
  .section-index {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.25rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-orange);
  }

  .section-index__mark {
    color: var(--color-ink);
    background-color: var(--color-orange);
    padding: 0 0.25rem;
    border-radius: 2px;
  }

  .section-index__number {
    font-variant-numeric: tabular-nums;
  }

  .section-index__label {
    color: var(--color-muted);
    letter-spacing: 0.12em;
  }
</style>

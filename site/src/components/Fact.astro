---
/**
 * The only renderer of a benchmark number.
 *
 * A page passes a fact id; the component reads the display value, unit,
 * evidence class and baseline from the generated register. `getFact` throws
 * during `astro build` when the id is unknown, so a missing fact cannot
 * silently render an empty figure. A unit and baseline are shown beside every
 * value so a number never appears without its evidence.
 *
 * With `drawer`, the class chip becomes a button that opens the fact's
 * evidence dialog. The dialog body is rendered beside the figure, so the
 * evidence is present in the server HTML even before the button is pressed.
 */
import EvidenceChip from './EvidenceChip.astro';
import { getFact } from '../lib/facts';

interface Props {
  id: string;
  drawer?: boolean;
  /**
   * Render the value alone. The caller owns the unit, the evidence mark and
   * the baseline (the home page's marks carry the class word beside it).
   */
  bare?: boolean;
  /** Opt the value into the count-up: `data-n` and `data-d` in the value span. */
  count?: boolean;
}

const { id, drawer = false, bare = false, count = false } = Astro.props;
const fact = getFact(id);
const classLabel = fact.class.charAt(0).toUpperCase() + fact.class.slice(1);
const provenance = fact.class === 'constant' || fact.class === 'generated';
const colour = provenance ? 'var(--color-muted)' : `var(--color-${fact.class})`;
const decimals = (fact.display.split('.')[1] ?? '').replace(/\D/g, '').length;
---

{bare ? (
  <span class="fact" data-fact-id={fact.id} data-fact-class={fact.class}>
    <span
      class="fact-value"
      data-n={count ? String(fact.raw) : undefined}
      data-d={count ? String(decimals) : undefined}
    >
      {fact.display}
    </span>
  </span>
) : (
  <span
    class="fact inline-flex flex-wrap items-baseline gap-x-1.5"
    data-fact-id={fact.id}
    data-fact-class={fact.class}
  >
    <span class="fact-value font-mono text-text">{fact.display}</span>
    {fact.unit !== '—' && fact.unit !== '' ? (
      <span class="fact-unit text-sm text-muted">{fact.unit}</span>
    ) : null}
    {drawer ? (
      <EvidenceChip id={fact.id} label={classLabel} />
    ) : (
      <span class="chip" style={`color: ${colour};`}>
        {classLabel}
      </span>
    )}
    {fact.baseline !== 'n/a' ? (
      <span class="fact-baseline text-sm text-muted">vs {fact.baseline}</span>
    ) : null}
  </span>
)}

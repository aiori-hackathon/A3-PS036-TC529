---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contrastRatio, palette, usedPairs } from '../lib/tokens';

const swatches = Object.entries(palette) as [string, string][];
const evidence = ['measured', 'derived', 'analytical', 'extrapolated'] as const;
const typeScale = [
  { name: 'display', className: 'text-6xl', sample: 'Post-quantum DNSSEC' },
  { name: 'title', className: 'text-4xl', sample: 'A ladder signed once per batch' },
  { name: 'heading', className: 'text-2xl', sample: 'Wire size, measured' },
  { name: 'body', className: 'text-base', sample: 'The quick brown fox jumps over the lazy dog.' },
  { name: 'small', className: 'text-sm', sample: 'Secondary copy and metadata live here.' },
  {
    name: 'mono',
    className: 'font-mono text-base',
    sample: 'Fact values render here, never typed here.',
  },
];
---

<BaseLayout
  title="Token gallery — CLIMB (development)"
  description="Development-only gallery of the site tokens, type scale and evidence colours."
>
  <div class="mx-auto max-w-6xl space-y-16 px-4 py-12 sm:px-6">
    <header class="space-y-3">
      <p class="font-mono text-xs tracking-widest text-orange uppercase">/_dev/tokens</p>
      <h1 class="text-5xl text-paper">Token gallery</h1>
      <p class="max-w-2xl text-muted">
        This route exists only while the development server runs. It is not part of a production
        build.
      </p>
    </header>

    <section class="space-y-6">
      <h2 class="text-2xl text-paper">Type scale</h2>
      <div class="space-y-6">
        {typeScale.map((row) => (
          <div class="border-t border-slate pt-4">
            <p class="font-mono text-xs tracking-widest text-muted uppercase">{row.name}</p>
            <p class={`${row.className} mt-2 text-text`}>{row.sample}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-6">
      <h2 class="text-2xl text-paper">Palette</h2>
      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        {swatches.map(([name, value]) => (
          <li>
            <div
              class="h-20 rounded-control border border-boundary"
              style={`background-color: ${value};`}
            />
            <p class="mt-2 font-mono text-sm text-text">{name}</p>
            <p class="font-mono text-xs text-muted uppercase">{value}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="space-y-6">
      <h2 class="text-2xl text-paper">Evidence classes</h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        {evidence.map((name) => (
          <li class="rounded-control border border-boundary p-4">
            <div
              class="flex h-16 items-center justify-center rounded-control font-mono text-sm"
              style={`background-color: var(--color-${name}); color: var(--color-ink);`}
            >
              {name}
            </div>
            <p class="mt-3 text-sm text-muted">
              Fill with the ink label; the class also carries a written label beside the value.
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class="space-y-6">
      <h2 class="text-2xl text-paper">Contrast pairs</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-boundary font-mono text-xs tracking-wider text-muted uppercase">
              <th class="py-2 pr-4">Foreground</th>
              <th class="py-2 pr-4">Background</th>
              <th class="py-2 pr-4">Ratio</th>
              <th class="py-2 pr-4">Minimum</th>
              <th class="py-2">Use</th>
            </tr>
          </thead>
          <tbody>
            {usedPairs.map((pair) => (
              <tr class="border-b border-slate">
                <td class="py-2 pr-4 font-mono text-text">{pair.foreground}</td>
                <td class="py-2 pr-4 font-mono text-text">{pair.background}</td>
                <td class="py-2 pr-4 font-mono text-text">
                  {contrastRatio(palette[pair.foreground], palette[pair.background]).toFixed(2)}
                </td>
                <td class="py-2 pr-4 font-mono text-muted">{pair.minimum.toFixed(1)}</td>
                <td class="py-2 text-muted">{pair.usage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>

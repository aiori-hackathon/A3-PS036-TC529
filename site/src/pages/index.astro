---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Fact from '../components/Fact.astro';
import HeroArt from '../components/HeroArt.astro';
import Marquee from '../components/Marquee.astro';
import TuiWindow from '../components/TuiWindow.astro';

const heroFacts = [
  {
    id: 'F-wire-medium-c-vs-a',
    label: 'Wire reduction, C against A',
  },
  {
    id: 'F-sign-medium-c-vs-a',
    label: 'Signing speed-up, C against A',
  },
  {
    id: 'F-verify-medium-c-vs-a',
    label: 'Verification speed-up, cached ladder, C against A',
  },
];

const marqueeItems = [
  'Wire bytes',
  'Signing',
  'Verifying',
  'Memory',
  'UDP fit',
  'Live DNS',
  'Method',
  'Reproduce',
];
---

<BaseLayout
  title="CLIMB — post-quantum DNSSEC, measured"
  description="Recording how Merkle Tree Ladder amortisation changes the size and cost of post-quantum DNSSEC signing with SLH-DSA."
>
  <section class="mx-auto max-w-6xl px-4 pt-12 pb-16 sm:px-6 sm:pt-20 lg:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16">
      <div data-hero-copy>
        <p class="font-mono text-xs tracking-[0.16em] text-orange uppercase">
          /01.00 PQC DNSSEC - MTL benchmark
        </p>

        <h1
          class="mt-5 max-w-3xl font-display text-5xl leading-[0.95] text-paper sm:text-6xl"
          data-hero-headline
        >
          Post-quantum DNSSEC, without the weight.
        </h1>

        <p class="mt-6 max-w-xl text-lg text-muted">
          Measuring how Merkle Tree Ladder amortisation changes the size and the cost of
          post-quantum DNSSEC signing with SLH-DSA.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button href="/dashboard">Open the dashboard</Button>
          <Button href="/method" variant="secondary">
            See the evidence
          </Button>
        </div>

        <p class="mt-4 text-sm text-muted">
          Recorded results, read from the committed artifact. This page is a viewer, not a service.
        </p>

        <ul
          class="mt-10 grid gap-4 sm:grid-cols-3 sm:gap-6"
          aria-label="Headline figures"
          data-hero-facts
        >
          {heroFacts.map((item) => (
            <li class="border-t border-slate pt-3">
              <p class="font-mono text-xs tracking-[0.16em] text-muted uppercase">{item.label}</p>
              <p class="mt-2">
                <Fact id={item.id} />
              </p>
            </li>
          ))}
        </ul>
      </div>

      <HeroArt class="lg:justify-self-end" />
    </div>
  </section>

  <Marquee items={marqueeItems} label="Sections of the record" />

  <section class="mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6" aria-labelledby="browser-window">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="font-mono text-xs tracking-[0.16em] text-orange uppercase">/01.50 the window</p>
        <h2 id="browser-window" class="mt-3 font-display text-3xl text-paper">
          The dashboard, in the browser
        </h2>
      </div>
      <p class="font-mono text-xs tracking-[0.12em] text-muted uppercase">no install · no server</p>
    </div>

    <p class="mb-6 max-w-2xl text-base text-muted">
      The same Rust dashboard the terminal runs, compiled to WebAssembly. It reads the recorded
      artifacts and waits until you reach it before it loads.
    </p>

    <TuiWindow mode="home" />
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import BandCanvas from '../components/BandCanvas.astro';
import Fact from '../components/Fact.astro';
import TuiWindow from '../components/TuiWindow.astro';
import team from '../data/team.json';
import { getFact } from '../lib/facts';
import { capabilities, homeData } from '../lib/home-data';
import { SCOPE_SENTENCE } from '../lib/limits';

const raw = (id: string): number => {
  const value = getFact(id).raw;
  return typeof value === 'number' ? value : 0;
};
const wireA = raw('F-wire-medium-a');
const wireB = raw('F-wire-medium-b');
const wireC = raw('F-wire-medium-c');
const barA = ((wireA / wireB) * 100).toFixed(1);
const barC = ((wireC / wireB) * 100).toFixed(1);
const fit = getFact('F-udp-c-fit');
const homeJson = JSON.stringify(homeData).replaceAll('<', '\\u003c');

const crates = [
  'climb-mtl-sys',
  'climb-mtl',
  'climb-dns',
  'climb-analytical',
  'climb-bench',
  'climb-report',
  'climb-tui',
  'climb-web',
  'xtask',
];
---

<BaseLayout
  title="CLIMB: Cryptographic Ladder Impact Measurement Benchmark"
  description="CLIMB is a reproducible Rust benchmark measuring how Merkle Tree Ladder amortisation changes the performance and wire efficiency of post-quantum DNSSEC signing with SLH-DSA."
  home
>
  <section class="hero">
    <canvas id="gc" aria-hidden="true"></canvas>
    <div class="w hg">
      <div class="lo">
        <canvas id="ob" aria-hidden="true"></canvas>
        <i
          class="hl logo"
          role="img"
          aria-label="CLIMB, Cryptographic Ladder Impact Measurement Benchmark"
        ></i>
        <canvas id="of" aria-hidden="true"></canvas>
      </div>
    </div>
    <div class="w intro">
      <div>
        <h1>Post-quantum DNSSEC, measured.</h1>
        <p class="ld">
          Measuring how Merkle Tree Ladder amortisation changes the performance and wire efficiency
          of post-quantum DNSSEC signing with SLH-DSA.
        </p>
        <div class="cta">
          <a class="btn p" href="#results">
            Explore the benchmark
          </a>
          <a class="btn" href="https://github.com/aiori-hackathon/A3-PS036-TC529" rel="noopener">
            View on GitHub
          </a>
        </div>
        <p class="mt">
          AIORI-3 Hackathon, problem statement PS-036. Experimental research benchmark.
        </p>
      </div>
    </div>
  </section>

  <section id="results">
    <div class="w">
      <div class="sh">
        <h2>Results</h2>
        <p>
          Every figure carries its evidence class and baseline. Values come from the repository’s
          recorded artifacts, Medium dataset.
        </p>
      </div>
      <ol class="led">
        <li>
          <span class="ev d">Derived</span>
          <span class="nm">
            <Fact id="F-wire-medium-c-vs-a" bare count />%
          </span>
          <p>
            Wire reduction, C vs A. From measured bytes:&#32;
            <Fact id="F-wire-medium-c" bare /> B vs <Fact id="F-wire-medium-a" bare /> B.
          </p>
        </li>
        <li>
          <span class="ev d">Derived</span>
          <span class="nm">
            <Fact id="F-sign-medium-c-vs-a" bare count />×
          </span>
          <p>
            Signing speed-up, C vs A. Across <Fact id="F-sign-spread-runs" bare /> stability runs
            the median is <Fact id="F-sign-spread-median" bare />× (
            <Fact id="F-sign-spread-min" bare />–<Fact id="F-sign-spread-max" bare />
            ×). Per-message cost scaled to batch size.
          </p>
        </li>
        <li>
          <span class="ev d">Derived</span>
          <span class="nm">
            <Fact id="F-verify-medium-c-vs-a" bare count />×
          </span>
          <p>Verification speed-up, C vs A, with a trusted cached ladder.</p>
        </li>
        <li>
          <span class="ev a">Analytical</span>
          <span class="nm">
            <span
              data-fact-id="F-udp-c-fit"
              data-fact-class={fit.class}
              data-n={String(fit.raw)}
              data-d="0"
            >
              {fit.display.split(' ')[0]}
            </span>
            &#32;of&#32;
            <Fact id="F-udp-c-total" bare />
          </span>
          <p>
            Modelled UDP response profiles that fit the&#32;
            <Fact id="F-udp-payload" bare />
            -byte payload in configuration C.
          </p>
        </li>
        <li>
          <span class="ev m">Measured</span>
          <span class="nm">
            <Fact id="F-dns-rtt-multiple-condensed-50" bare />×
          </span>
          <p>
            NSD round trips at an emulated <Fact id="F-dns-rtt-target" bare /> ms RTT, condensed
            against <Fact id="F-dns-rtt-multiple-plain-50" bare />× plain. Emulated RTT, local
            bridge, not Internet latency. The reference Unbound build serves full responses in both
            modes.
          </p>
        </li>
      </ol>
      <div class="key">
        <span class="ev m">Measured: recorded directly</span>
        <span class="ev d">Derived: computed from measurements</span>
        <span class="ev a">Analytical: closed-form model</span>
        <span class="ev x">Extrapolated: unit cost × count</span>
      </div>
      <p class="note">
        Definitions in{' '}
        <a
          href="https://github.com/aiori-hackathon/A3-PS036-TC529/blob/main/docs/METHODOLOGY.md"
          rel="noopener"
        >
          docs/METHODOLOGY.md
        </a>
        . Full table in{' '}
        <a
          href="https://github.com/aiori-hackathon/A3-PS036-TC529/blob/main/docs/deck-facts.md"
          rel="noopener"
        >
          docs/deck-facts.md
        </a>
        .
      </p>
    </div>
  </section>

  <BandCanvas mode="0" />

  <section id="capabilities">
    <div class="w">
      <div class="sh">
        <h2>Capabilities</h2>
        <p>
          Seven things the benchmark measures, each reproducible from one command. Select a card to
          open it in the ladder.
        </p>
      </div>
      <div class="cds" id="cds">
        {capabilities.map((capability, index) => (
          <button class="cd" type="button" data-branch={String(index)}>
            <span class="k">({String.fromCharCode(97 + index)})</span>
            <h3>{capability.title}</h3>
            <p>{capability.card}</p>
            <span class="mo">{capability.command}</span>
          </button>
        ))}
        <a class="cd or" href="/tui">
          <span>Open the dashboard</span>
          <b>Recorded terminal dashboard ↗</b>
        </a>
      </div>
    </div>
  </section>

  <section id="ladder">
    <div class="w">
      <div class="sh">
        <h2>Explore the ladder</h2>
        <p>
          Choose a capability to open its branches, then a leaf to see its evidence class and the
          command that reproduces it.
        </p>
      </div>
      <div class="lad" id="lad">
        <svg id="sv" aria-hidden="true"></svg>
        <div class="rt" id="rt">
          CLIMB<small>ladder</small>
        </div>
        <div class="cp" id="cp" role="group" aria-label="Capabilities"></div>
        <div class="lv" id="lv" role="group" aria-label="Branches"></div>
        <article class="dt" id="dt" aria-live="polite" aria-atomic="true"></article>
      </div>
    </div>
  </section>

  <BandCanvas mode="1" />

  <section id="how">
    <div class="w">
      <div class="sh">
        <h2>How it works</h2>
        <p>
          In C, one signed ladder is shared across a batch. Each response carries only a small
          condensed authentication path, not the full ladder.
        </p>
      </div>
      <div class="tb" role="tablist" aria-label="Configurations">
        <button role="tab" id="t0" aria-selected="true" aria-controls="panel">
          A · Plain SLH-DSA
        </button>
        <button role="tab" id="t1" aria-selected="false" aria-controls="panel" tabindex="-1">
          B · MTL, no amortisation
        </button>
        <button role="tab" id="t2" aria-selected="false" aria-controls="panel" tabindex="-1">
          C · MTL amortised
        </button>
      </div>
      <div class="hw">
        <div role="tabpanel" id="panel" aria-live="polite">
          <h3 id="ph"></h3>
          <p id="pp"></p>
          <div class="bars" id="bars">
            <p>
              <span class="ev m">Measured</span> Wire bytes, Medium dataset
            </p>
            <div class="bar">
              <span>A</span>
              <div class="trk">
                <div class="fill" data-w={barA}></div>
                <span class="val" style="right:8px">
                  <Fact id="F-wire-medium-a" bare /> B
                </span>
              </div>
            </div>
            <div class="bar">
              <span>B</span>
              <div class="trk">
                <div class="fill" data-w="100"></div>
                <span class="val" style="right:8px">
                  <Fact id="F-wire-medium-b" bare /> B
                </span>
              </div>
            </div>
            <div class="bar">
              <span>C</span>
              <div class="trk">
                <div class="fill" data-w={barC}></div>
                <span class="val" style={`left:calc(${barC}% + 8px)`}>
                  <Fact id="F-wire-medium-c" bare /> B
                </span>
              </div>
            </div>
          </div>
        </div>
        <div class="dg">
          <svg
            viewBox="0 0 360 232"
            role="img"
            aria-label="Diagram of what each of three messages carries in the selected configuration"
            font-family="Geist,sans-serif"
            font-size="11"
          >
            <g fill="none" stroke="#a9a398">
              <rect x="20" y="96" width="80" height="26"></rect>
              <rect x="140" y="96" width="80" height="26"></rect>
              <rect x="260" y="96" width="80" height="26"></rect>
            </g>
            <g fill="#a9a398" text-anchor="middle">
              <text x="60" y="113">
                message 1
              </text>
              <text x="180" y="113">
                message 2
              </text>
              <text x="300" y="113">
                message 3
              </text>
            </g>
            <g id="gA" fill="#f2ede4">
              <rect x="20" y="130" width="80" height="48"></rect>
              <rect x="140" y="130" width="80" height="48"></rect>
              <rect x="260" y="130" width="80" height="48"></rect>
            </g>
            <g id="gB">
              <g fill="#ff5400">
                <rect x="20" y="130" width="80" height="14"></rect>
                <rect x="140" y="130" width="80" height="14"></rect>
                <rect x="260" y="130" width="80" height="14"></rect>
              </g>
              <g fill="#f2ede4">
                <rect x="20" y="146" width="80" height="38"></rect>
                <rect x="140" y="146" width="80" height="38"></rect>
                <rect x="260" y="146" width="80" height="38"></rect>
              </g>
            </g>
            <g
              id="gC"
              data-packets="M180 42V69H60V96@0;M180 42V96@.35;M180 42V69H300V96@.7"
              data-packet-dur="2"
            >
              <rect x="30" y="14" width="300" height="28" fill="#f2ede4"></rect>
              <text x="180" y="32" text-anchor="middle" fill="#07080a" font-weight="600">
                one signed ladder
              </text>
              <path
                class="fw"
                d="M60 96V69H300V96M180 69V42"
                stroke="#ff5400"
                stroke-width="2"
                fill="none"
              ></path>
              <g fill="#ff5400">
                <rect x="20" y="130" width="80" height="12"></rect>
                <rect x="140" y="130" width="80" height="12"></rect>
                <rect x="260" y="130" width="80" height="12"></rect>
              </g>
            </g>
            <text id="gt" x="180" y="204" text-anchor="middle" fill="#a9a398"></text>
            <rect x="82" y="216" width="8" height="8" fill="#f2ede4"></rect>
            <text x="96" y="224" fill="#a9a398">
              signature or ladder
            </text>
            <rect x="210" y="216" width="8" height="8" fill="#ff5400"></rect>
            <text x="224" y="224" fill="#a9a398">
              condensed path
            </text>
          </svg>
          <ul class="dg-legend">
            <li>
              <span class="ev m">Measured</span> Plain signature{' '}
              <Fact id="F-message-bytes-a" bare /> B
            </li>
            <li>
              <span class="ev m">Measured</span> Signed ladder{' '}
              <Fact id="F-ladder-signed-medium" bare /> B
            </li>
            <li>
              <span class="ev m">Measured</span> Condensed path minimum{' '}
              <Fact id="F-condensed-path-bytes" bare /> B
            </li>
            <li>
              <span class="ev d">Derived</span> Mean per message: B{' '}
              <Fact id="F-message-bytes-b" bare /> B · C <Fact id="F-message-bytes-c" bare /> B
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <BandCanvas mode="0" />

  <section id="architecture">
    <div class="w">
      <div class="sh">
        <h2>Architecture</h2>
        <p>
          A Rust workspace links OpenSSL, liboqs and libMTL, benchmarks with Criterion, and captures
          live DNS from patched NSD and Unbound in Docker.
        </p>
      </div>
      <div class="arch">
        <svg
          viewBox="0 0 920 300"
          role="img"
          aria-label="Pinned OpenSSL, liboqs, libMTL and Docker inputs feed the nine-crate Rust workspace, which produces the results artifact, the report, the TUI dashboard and the site pages"
          font-family="Geist,sans-serif"
          font-size="12"
          fill="#f2ede4"
          data-crates={crates.join(' ')}
        >
          <text x="84" y="20" text-anchor="middle" fill="#a9a398">
            Pinned inputs
          </text>
          <text x="396" y="20" text-anchor="middle" fill="#a9a398">
            Rust workspace — nine members
          </text>
          <text x="820" y="20" text-anchor="middle" fill="#a9a398">
            Artifacts
          </text>
          <g fill="#0d0f13" stroke="rgba(242,237,228,.22)">
            <rect x="8" y="40" width="152" height="34" rx="4"></rect>
            <rect x="8" y="92" width="152" height="34" rx="4"></rect>
            <rect x="8" y="144" width="152" height="34" rx="4"></rect>
            <rect x="8" y="196" width="152" height="34" rx="4"></rect>
            <rect x="230" y="36" width="132" height="38" rx="4"></rect>
            <rect x="378" y="36" width="132" height="38" rx="4"></rect>
            <rect x="526" y="36" width="132" height="38" rx="4"></rect>
            <rect x="230" y="104" width="132" height="38" rx="4"></rect>
            <rect x="378" y="104" width="132" height="38" rx="4"></rect>
            <rect x="526" y="104" width="132" height="38" rx="4" stroke="#ff5400"></rect>
            <rect x="230" y="172" width="132" height="38" rx="4"></rect>
            <rect x="378" y="172" width="132" height="38" rx="4"></rect>
            <rect x="526" y="172" width="132" height="38" rx="4"></rect>
            <rect x="730" y="40" width="180" height="34" rx="4"></rect>
            <rect x="730" y="92" width="180" height="34" rx="4"></rect>
            <rect x="730" y="144" width="180" height="34" rx="4"></rect>
            <rect x="730" y="196" width="180" height="34" rx="4"></rect>
          </g>
          <g stroke="rgba(255,84,0,.6)" stroke-width="1.4" fill="none">
            <path d="M160 57H195V55H230M160 109H195V94H230M160 161H195V132H230M160 213H195V190H230"></path>
            <path d="M362 55H378"></path>
            <path d="M658 55H700V57H730M658 123H700V109H730M658 191H700V161H730M596 210V250H700V213H730"></path>
          </g>
          <g text-anchor="middle">
            <text x="84" y="61">
              OpenSSL
            </text>
            <text x="84" y="113">
              liboqs
            </text>
            <text x="84" y="165">
              libMTL
            </text>
            <text x="84" y="217">
              Docker build
            </text>
            <text x="296" y="59">
              climb-mtl-sys
            </text>
            <text x="444" y="59">
              climb-mtl
            </text>
            <text x="592" y="59">
              climb-dns
            </text>
            <text x="296" y="127">
              climb-analytical
            </text>
            <text x="444" y="127">
              climb-bench
            </text>
            <text x="592" y="127">
              climb-report
            </text>
            <text x="296" y="195">
              climb-tui
            </text>
            <text x="444" y="195">
              climb-web
            </text>
            <text x="592" y="195">
              xtask
            </text>
            <text x="820" y="61">
              climb-results.json
            </text>
            <text x="820" y="113">
              report.html
            </text>
            <text x="820" y="165">
              TUI dashboard
            </text>
            <text x="820" y="217">
              site pages
            </text>
          </g>
          <g fill="#a9a398" font-size="11">
            <text x="230" y="88">
              FFI and safe wrapper
            </text>
            <text x="378" y="156">
              harness and models
            </text>
            <text x="378" y="224">
              dashboards and automation
            </text>
            <text x="730" y="250">
              same artifacts the site reads
            </text>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <BandCanvas mode="1" />

  <section id="dashboard">
    <div class="w">
      <div class="sh">
        <h2>Dashboard</h2>
        <p>
          The recorded run, rendered in the browser from the committed artifacts. It loads when you
          reach it and needs no server.
        </p>
      </div>
      <div class="dash">
        <TuiWindow mode="home" />
      </div>
    </div>
  </section>

  <section id="transparency">
    <div class="w">
      <div class="sh">
        <h2>Transparency</h2>
        <p>
          Nothing on this page is typed in by hand. Each number is read from a recorded artifact and
          checked against a claims registry.
        </p>
      </div>
      <div class="tr">
        <div>
          <h3>Reproducible datasets</h3>
          <p>
            Deterministic datasets in <Fact id="F-wire-sizes" bare /> sizes and repeated trials. One
            command, <code>cargo xtask reproduce</code>, rebuilds the artifact chain.
          </p>
        </div>
        <div>
          <h3>Pinned and fingerprinted</h3>
          <p>
            liboqs and libMTL are pinned submodules. <code>environment.json</code> records CPU,
            kernel and toolchain.
          </p>
        </div>
        <div>
          <h3>Claims registry</h3>
          <p>
            Each claim stores its JSON pointer, expected value and pass or fail mark.{' '}
            <Fact id="F-claims-count" bare /> verified: <Fact id="F-claims-measured" bare />{' '}
            measured, <Fact id="F-claims-derived" bare /> derived,{' '}
            <Fact id="F-claims-analytical" bare /> analytical,{' '}
            <Fact id="F-claims-extrapolated" bare /> extrapolated and{' '}
            <Fact id="F-claims-generated" bare /> generated.
          </p>
        </div>
      </div>
      <div class="lim">
        <h3>Known experimental limits</h3>
        <p>
          Results are empirical. No formal security guarantee, proof or certification is claimed for
          MTL mode, SLH-DSA or any component. They cover one parameter set (
          <Fact id="F-parameter-set" bare />
          ), one reference implementation and one laptop-class machine. Native SLH-DSA is not
          SIMD-tuned in the pinned build. {SCOPE_SENTENCE}
        </p>
      </div>
      <a
        class="lk"
        href="https://github.com/aiori-hackathon/A3-PS036-TC529/blob/main/docs/METHODOLOGY.md"
        rel="noopener"
      >
        Read the methodology ↗
      </a>
    </div>
  </section>

  <BandCanvas mode="0" />

  <section id="team">
    <div class="w">
      <div class="sh">
        <h2>Team CLIMB</h2>
        <p>
          {team.event}, problem statement {team.problem}, team code {team.team}.
        </p>
      </div>
      <ul class="tm">
        {team.members.map((member) => (
          <li>
            <h3>{member.name}</h3>
            <span>{member.role}</span>
            <a href={member.link.href} rel="noopener">
              {member.link.label}
              {member.link.label === 'GitHub' ? ' profile' : ''} ↗
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <script type="application/json" id="climb-data" set:html={homeJson}></script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const evidence = [
  { label: 'Measured', token: 'measured' },
  { label: 'Derived', token: 'derived' },
  { label: 'Analytical', token: 'analytical' },
  { label: 'Extrapolated', token: 'extrapolated' },
];
---

<BaseLayout
  title="CLIMB — post-quantum DNSSEC, measured"
  description="Recording how Merkle Tree Ladder amortisation changes the size and cost of post-quantum DNSSEC signing with SLH-DSA."
>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-24 sm:px-6 sm:pt-24">
    <p class="font-mono text-xs tracking-widest text-orange uppercase">
      /01.00 PQC DNSSEC - MTL benchmark
    </p>
    <h1 class="mt-6 max-w-3xl text-5xl leading-none text-paper sm:text-6xl">
      Post-quantum DNSSEC, without the weight.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      Measuring how Merkle Tree Ladder amortisation changes the size and the cost of post-quantum
      DNSSEC signing with SLH-DSA.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        class="rounded-control bg-orange px-5 py-3 text-sm font-medium text-ink hover:bg-paper"
        href="/dashboard"
      >
        Open the dashboard
      </a>
      <a
        class="rounded-control border border-boundary px-5 py-3 text-sm font-medium text-text hover:border-teal hover:text-teal"
        href="/method"
      >
        See the evidence
      </a>
    </div>
    <p class="mt-4 text-sm text-muted">
      Recorded results, read from the committed artifact. This page is a viewer, not a service.
    </p>

    <div class="panel mt-16 p-6 sm:p-8">
      <h2 class="text-2xl text-paper">Every figure carries its evidence class</h2>
      <p class="mt-3 max-w-2xl text-sm text-muted">
        Measured values are read from an artifact; derived values are computed from recorded values;
        analytical values come from a closed-form model; extrapolated values are a unit cost times a
        count and carry an approximation mark.
      </p>
      <ul class="mt-6 flex flex-wrap gap-3">
        {evidence.map((item) => (
          <li>
            <span class="chip" style={`color: var(--color-${item.token});`}>
              {item.label}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

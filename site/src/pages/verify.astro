---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyCommand from '../components/CopyCommand.astro';
import Fact from '../components/Fact.astro';
import { evidence } from '../lib/evidence';
import { provenance, recordedDate, recordedOffset } from '../lib/provenance';
import { commands } from '../lib/reproduce';
import {
  claimCounts,
  claimPointerHref,
  claimSearchText,
  claimStatus,
  classLabel,
  presentClasses,
  presentSizes,
  registryStatus,
  sizeLabel,
  claims as registry,
} from '../lib/verify';

const counts = claimCounts(registry);
const status = registryStatus(registry);
const classes = presentClasses(registry);
const sizes = presentSizes(registry);
const check = evidence.report.check;
const firstFail = registry.find((claim) => !claim.verified);
const drift = check === null ? null : check.drift + check.missing;
const verifyCommand = commands.verify.lines[0] ?? 'cargo xtask sample-check';

const rows = registry.map((claim) => ({
  ...claim,
  search: claimSearchText(claim),
  rowStatus: claimStatus(claim),
  rowClass: claim.class ?? 'unknown',
  rowSize: claim.size ?? 'none',
  classText: classLabel(claim.class),
  sizeText: sizeLabel(claim.size),
  href: claimPointerHref(claim.pointer),
}));
---

<BaseLayout
  title="CLIMB — verify the numbers"
  description="The full CLIMB claims registry: every claim, its JSON pointer, its recorded value and whether it resolved, plus the report-versus-results check."
>
  <section class="mx-auto max-w-6xl px-4 pt-12 pb-10 sm:px-6 sm:pt-16">
    <p class="font-mono text-xs tracking-[0.16em] text-orange uppercase">
      /05.00 check it yourself
    </p>

    <h1 class="mt-5 max-w-3xl font-display text-5xl leading-[0.95] text-paper sm:text-6xl">
      Verify the numbers
    </h1>

    <p class="mt-6 max-w-2xl text-lg text-muted">
      Every number the site shows is a claim in the registry. Each claim stores its pointer, its
      expected value and its pass mark.
    </p>

    <p class="mt-4 max-w-2xl text-base text-muted" data-verify-scope>
      The generated badge reports <Fact id="F-claims-count" /> claims verified.
    </p>

    <div class="mt-8 max-w-2xl">
      <CopyCommand
        id="verify-command"
        label="Copy the verify command"
        command={verifyCommand}
        note="The count is generated by the badge step, not typed in."
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6" aria-labelledby="verify-banner-heading">
    <h2 id="verify-banner-heading" class="sr-only">
      Registry status
    </h2>

    <div
      class="verify-banner"
      data-registry-status={status}
      data-report-drift={drift ?? 'unavailable'}
    >
      <p class="verify-banner__headline" data-registry-headline>
        {status === 'empty'
          ? 'No claims registry is available for this artifact.'
          : status === 'failing'
            ? 'A claim did not resolve to its recorded value. The failing pointer is named.'
            : 'Every registered claim resolved to its recorded value.'}
      </p>

      <p class="verify-banner__detail">
        {drift === null ? (
          <>No report is present, so the report-versus-results check could not run.</>
        ) : drift === 0 ? (
          <>
            The report and the results agree on {check?.agree} claims; neither drift nor a missing
            claim was found.
          </>
        ) : (
          <>
            The report and the results disagree on {drift} claims. The table marks each row's own
            result; a disagreement is reported, not hidden.
          </>
        )}
      </p>

      {firstFail === undefined ? null : (
        <p class="verify-banner__fail" data-first-failure>
          First failing claim: <code class="font-mono text-text">{firstFail.pointer}</code>
        </p>
      )}

      <p class="verify-banner__provenance">
        Recorded run <code class="font-mono text-text">{provenance.commit_short}</code> on
        <time datetime={provenance.date}>{recordedDate(provenance.date)}</time>
        {recordedOffset(provenance.date)}.
        <a class="verify-banner__link" href="/report">
          See the report
        </a>
        .
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6" aria-labelledby="claims-heading">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <h2 id="claims-heading" class="font-display text-3xl text-paper">
        The claims registry
      </h2>
      <p class="font-mono text-xs tracking-[0.12em] text-muted uppercase">
        {counts.pass} pass · {counts.fail} fail · {counts.total} registered
      </p>
    </div>

    {registry.length === 0 ? (
      <p class="text-base text-muted">
        No claims registry is available for this artifact. The download on the report page is still
        available.
      </p>
    ) : (
      <>
        <div class="claims-controls" data-claims-controls>
          <div class="claims-controls__field">
            <label class="claims-controls__label" for="claims-search">
              Search claims
            </label>
            <input
              class="claims-controls__input"
              id="claims-search"
              type="search"
              autocomplete="off"
              placeholder="id, pointer, value, class or size"
              data-claims-search
            />
          </div>

          <div class="claims-controls__field">
            <label class="claims-controls__label" for="claims-status">
              Result
            </label>
            <select class="claims-controls__input" id="claims-status" data-claims-status>
              <option value="all">All claims</option>
              <option value="pass">Passed only</option>
              <option value="fail">Failed only</option>
            </select>
          </div>

          <div class="claims-controls__field">
            <label class="claims-controls__label" for="claims-class">
              Evidence class
            </label>
            <select class="claims-controls__input" id="claims-class" data-claims-class>
              <option value="all">Every class</option>
              {classes.map((value) => (
                <option value={value}>{classLabel(value)}</option>
              ))}
            </select>
          </div>

          <div class="claims-controls__field">
            <label class="claims-controls__label" for="claims-size">
              Dataset size
            </label>
            <select class="claims-controls__input" id="claims-size" data-claims-size>
              <option value="all">Every size</option>
              {sizes.map((value) => (
                <option value={value}>{sizeLabel(value)}</option>
              ))}
            </select>
          </div>

          <button class="claims-controls__reset" type="button" data-claims-reset>
            Reset filters
          </button>
        </div>

        <noscript>
          <p class="mt-3 text-sm text-muted">
            Filtering needs JavaScript. The full registry is listed below.
          </p>
        </noscript>

        <p class="claims-count" role="status" aria-live="polite" data-claims-count>
          Showing {counts.total} of {counts.total} claims.
        </p>

        <div class="claims-table-wrap">
          <table class="claims-table" data-claims-table>
            <caption class="sr-only">
              Every registered claim with its pointer, recorded value, evidence class, dataset size
              and result.
            </caption>
            <thead>
              <tr>
                <th scope="col">Result</th>
                <th scope="col">Claim</th>
                <th scope="col">Pointer</th>
                <th scope="col">Value</th>
                <th scope="col">Class</th>
                <th scope="col">Size</th>
              </tr>
            </thead>
            <tbody data-claims-body>
              {rows.map((claim) => (
                <tr
                  data-claim-row
                  data-search={claim.search}
                  data-status={claim.rowStatus}
                  data-class={claim.rowClass}
                  data-size={claim.rowSize}
                >
                  <td>
                    <span
                      class:list={['claim-result', `claim-result--${claim.rowStatus}`]}
                      data-claim-result={claim.rowStatus}
                    >
                      {claim.rowStatus === 'pass' ? 'Pass' : 'Fail'}
                    </span>
                  </td>
                  <td class="font-mono text-xs text-text">{claim.id}</td>
                  <td>
                    <a
                      class="claim-pointer"
                      href={claim.href}
                      title="Open this pointer in the results artifact"
                    >
                      {claim.pointer}
                    </a>
                  </td>
                  <td class="font-mono text-xs text-text">{claim.formatted}</td>
                  <td>
                    <span class:list={['chip', `claim-chip`]} data-claim-class={claim.rowClass}>
                      {claim.classText}
                    </span>
                  </td>
                  <td class="text-sm text-muted">{claim.sizeText}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="claims-empty" data-claims-empty hidden>
          No claim matches these filters. Widen the search or reset the filters.
        </p>
      </>
    )}
  </section>
</BaseLayout>

<script>
  import { DEFAULT_FILTERS, rowMatchesFilters, type ClaimFilters } from '../lib/verify';

  const root = document.querySelector<HTMLElement>('[data-claims-controls]');
  const table = document.querySelector<HTMLElement>('[data-claims-table]');
  const count = document.querySelector<HTMLElement>('[data-claims-count]');
  const empty = document.querySelector<HTMLElement>('[data-claims-empty]');
  const search = document.querySelector<HTMLInputElement>('[data-claims-search]');
  const status = document.querySelector<HTMLSelectElement>('[data-claims-status]');
  const className = document.querySelector<HTMLSelectElement>('[data-claims-class]');
  const size = document.querySelector<HTMLSelectElement>('[data-claims-size]');
  const reset = document.querySelector<HTMLButtonElement>('[data-claims-reset]');

  if (root !== null && table !== null && count !== null) {
    const rows = [...table.querySelectorAll<HTMLTableRowElement>('[data-claim-row]')];

    const current = (): ClaimFilters => ({
      query: search?.value ?? DEFAULT_FILTERS.query,
      status: (status?.value ?? DEFAULT_FILTERS.status) as ClaimFilters['status'],
      className: className?.value ?? DEFAULT_FILTERS.className,
      size: size?.value ?? DEFAULT_FILTERS.size,
    });

    const apply = (): void => {
      const filters = current();
      let shown = 0;
      for (const row of rows) {
        const visible = rowMatchesFilters(
          {
            search: row.dataset.search ?? '',
            status: (row.dataset.status ?? 'fail') as 'pass' | 'fail',
            className: row.dataset.class ?? 'unknown',
            size: row.dataset.size ?? 'none',
          },
          filters,
        );
        row.hidden = !visible;
        if (visible) {
          shown += 1;
        }
      }
      count.textContent = `Showing ${shown} of ${rows.length} claims.`;
      if (empty !== null) {
        empty.hidden = shown !== 0;
      }
    };

    search?.addEventListener('input', apply);
    status?.addEventListener('change', apply);
    className?.addEventListener('change', apply);
    size?.addEventListener('change', apply);
    reset?.addEventListener('click', () => {
      if (search !== null) search.value = '';
      if (status !== null) status.value = 'all';
      if (className !== null) className.value = 'all';
      if (size !== null) size.value = 'all';
      apply();
      search?.focus();
    });

    root.dataset.claimsReady = 'true';
  }
</script>

<style>
  .verify-banner {
    border: 1px solid var(--color-boundary);
    border-left: 4px solid var(--color-teal);
    border-radius: var(--radius-panel);
    background-color: var(--color-raised);
    padding: 1.25rem 1.5rem;
  }

  .verify-banner[data-report-drift='unavailable'] {
    border-left-color: var(--color-slate);
  }

  .verify-banner[data-registry-status='failing'] {
    border-left-color: var(--color-orange);
  }

  .verify-banner__headline {
    margin: 0;
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }

  .verify-banner__detail,
  .verify-banner__fail,
  .verify-banner__provenance {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .verify-banner__fail {
    color: var(--color-orange);
  }

  .verify-banner__link {
    color: var(--color-orange);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .claims-controls {
    display: grid;
    gap: 0.75rem;
    border: 1px solid var(--color-boundary);
    border-radius: var(--radius-panel);
    background-color: var(--color-surface);
    padding: 1rem;
  }

  @media (min-width: 40rem) {
    .claims-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .claims-controls {
      grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr)) auto;
      align-items: end;
    }
  }

  .claims-controls__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .claims-controls__label {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .claims-controls__input {
    width: 100%;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-control);
    background-color: var(--color-ink);
    padding: 0.5rem 0.75rem;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }

  .claims-controls__reset {
    border: 1px solid var(--color-boundary);
    border-radius: 999px;
    background-color: transparent;
    padding: 0.5rem 0.875rem;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    justify-self: start;
  }

  .claims-controls__reset:hover {
    border-color: var(--color-teal);
    color: var(--color-teal);
  }

  .claims-count {
    margin: 0.75rem 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .claims-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-boundary);
    border-radius: var(--radius-panel);
    background-color: var(--color-raised);
  }

  .claims-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .claims-table th {
    position: sticky;
    top: 0;
    z-index: 1;
    border-bottom: 1px solid var(--color-boundary);
    background-color: var(--color-surface);
    padding: 0.625rem 0.75rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-align: left;
    text-transform: uppercase;
  }

  .claims-table td {
    border-bottom: 1px solid var(--color-rule);
    padding: 0.625rem 0.75rem;
    vertical-align: top;
  }

  /*
   * The table is complete in the server HTML; the browser is only asked to
   * skip paint and layout for rows far outside the viewport, which keeps a
   * registry of this size responsive without a client-side row factory.
   */
  .claims-table tbody tr {
    content-visibility: auto;
    contain-intrinsic-size: auto 3.25rem;
  }

  .claims-table tbody tr:hover td {
    background-color: var(--color-surface);
  }

  .claim-result {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .claim-result::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background-color: currentColor;
  }

  .claim-result--pass {
    color: var(--color-teal);
  }

  .claim-result--fail {
    color: var(--color-orange);
  }

  .claim-pointer {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .claim-pointer:hover {
    color: var(--color-orange);
  }

  .claim-chip {
    color: var(--color-muted);
    font-size: 0.6875rem;
  }

  .claim-chip[data-claim-class='measured'] {
    color: var(--color-measured);
  }

  .claim-chip[data-claim-class='derived'] {
    color: var(--color-derived);
  }

  .claim-chip[data-claim-class='analytical'] {
    color: var(--color-analytical);
  }

  .claim-chip[data-claim-class='extrapolated'] {
    color: var(--color-extrapolated);
  }

  .claims-empty {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
